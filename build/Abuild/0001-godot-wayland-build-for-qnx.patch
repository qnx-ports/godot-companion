From 00357a4be854d117ae1e6985bd55a5fdf72022ba Mon Sep 17 00:00:00 2001
From: felixlionardo <flionardo@blackberry.com>
Date: Fri, 10 Oct 2025 10:50:39 -0400
Subject: [PATCH] godot wayland build for qnx

---
 platform/linuxbsd/detect.py                  | 9 +++++++--
 platform/linuxbsd/wayland/wayland_thread.cpp | 2 ++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/platform/linuxbsd/detect.py b/platform/linuxbsd/detect.py
index b5e80f4a4d..e905462054 100644
--- a/platform/linuxbsd/detect.py
+++ b/platform/linuxbsd/detect.py
@@ -464,7 +464,8 @@ def configure(env: "SConsEnvironment"):
             env.Append(CPPDEFINES=["LIBDECOR_ENABLED"])
 
         env.Append(CPPDEFINES=["WAYLAND_ENABLED"])
-        env.Append(LIBS=["rt"])  # Needed by glibc, used by _allocate_shm_file
+        if not platform.system() == "QNX":
+            env.Append(LIBS=["rt"])  # Needed by glibc, used by _allocate_shm_file
 
     if env["vulkan"]:
         env.Append(CPPDEFINES=["VULKAN_ENABLED", "RD_ENABLED"])
@@ -477,7 +478,11 @@ def configure(env: "SConsEnvironment"):
     if env["opengl3"]:
         env.Append(CPPDEFINES=["GLES3_ENABLED"])
 
-    env.Append(LIBS=["pthread"])
+    if not platform.system() == "QNX":
+        env.Append(LIBS=["pthread"])
+    
+    if platform.system() == "QNX":
+        env.Append(LIBS=["socket", "GLESv2", "EGL"])
 
     if platform.system() == "Linux":
         env.Append(LIBS=["dl"])
diff --git a/platform/linuxbsd/wayland/wayland_thread.cpp b/platform/linuxbsd/wayland/wayland_thread.cpp
index e34807763b..f1db528754 100644
--- a/platform/linuxbsd/wayland/wayland_thread.cpp
+++ b/platform/linuxbsd/wayland/wayland_thread.cpp
@@ -34,6 +34,8 @@
 
 #ifdef __FreeBSD__
 #include <dev/evdev/input-event-codes.h>
+#elif __QNX__
+#include "input-event-codes.h"
 #else
 // Assume Linux.
 #include <linux/input-event-codes.h>
-- 
2.34.1

