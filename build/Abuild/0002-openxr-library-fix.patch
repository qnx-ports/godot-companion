From a22f0850c41bdc8c445d9a8dad09695b804da27e Mon Sep 17 00:00:00 2001
From: felixlionardo <flionardo@blackberry.com>
Date: Fri, 10 Oct 2025 10:48:33 -0400
Subject: [PATCH] openxr library fix

---
 thirdparty/openxr/src/common/platform_utils.hpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/thirdparty/openxr/src/common/platform_utils.hpp b/thirdparty/openxr/src/common/platform_utils.hpp
index 19cd41cbb2..3c06de3e37 100644
--- a/thirdparty/openxr/src/common/platform_utils.hpp
+++ b/thirdparty/openxr/src/common/platform_utils.hpp
@@ -93,7 +93,9 @@ static inline char* ImplGetEnv(const char* name) { return getenv(name); }
 
 // clang-format off
 static inline char* ImplGetSecureEnv(const char* name) {
-#ifdef HAVE_SECURE_GETENV
+#if defined(__QNX__)
+    return ImplGetEnv(name);
+#elif HAVE_SECURE_GETENV
     return secure_getenv(name);
 #elif defined(HAVE___SECURE_GETENV)
     return __secure_getenv(name);
-- 
